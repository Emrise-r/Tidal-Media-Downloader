# tidal-dl credentials via environment / .env
# Copy to `.env` (repo dir) or `~/.tidal-dl.env`, or point $TIDAL_ENV_FILE at it.
# Values here override the embedded keys in tidal_dl/apiKey.py.
# NOTE: real values must NOT be committed — .env / *.env are gitignored.

# --- Option 1: define a fully custom client (added as the last selectable key) ---
# Required to enable:
TIDAL_CLIENT_ID=your_client_id
# Leave blank for a public PKCE client (like the TIDAL desktop app):
TIDAL_CLIENT_SECRET=
# pkce (browser login) or device (device-code flow). Default: pkce
TIDAL_AUTH_METHOD=pkce
# OAuth scope (space-separated). Default: r_usr w_usr
TIDAL_SCOPE=r_usr w_usr
# Redirect URI registered for the client. Default: tidal://login/auth
TIDAL_REDIRECT_URI=tidal://login/auth
# Display label in the menu (optional)
TIDAL_CLIENT_NAME=My Client

# --- Option 2: only override the secret of an existing embedded key, by clientId ---
# e.g. the Android Auto device key (clientId zU4XHVVkc2tDPo4t):
# TIDAL_SECRET_zU4XHVVkc2tDPo4t=your_secret

# --- Optional: loopback callback port for PKCE browser login (default 8989) ---
# (set in the app profile ~/.tidal-dl.json as authCallbackPort, not here)
